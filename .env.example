# Copy to .env and fill in real values. Never commit .env.

# LLM (OpenRouter, OpenAI-compatible API); LLM_TIMEOUT: seconds per request (>= 1)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_TIMEOUT=60
# Coder: small, fast model. PM: larger model, 2-4 calls per run (C4.5)
LLM_MODEL=openai/gpt-4.1-mini
PM_MODEL=openai/gpt-4.1
# Coder's self-evaluation before the QA: larger model, 1-2 calls per review
EVALUATION_MODEL=openai/gpt-4.1

# Logging: DEBUG shows the full LLM input, INFO the retrieved memories
LOG_LEVEL=INFO

# Memory
SLIDING_WINDOW_SIZE=5
MEMORY_TOP_K=3
CHROMA_PATH=.chroma
# Set only when running against a Chroma server (Docker)
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# Tools: script timeout in seconds (1-30), read_file limit in characters,
# Coder working directory (relative to the repo root; replaces WORKSPACE_DIR)
EXEC_TIMEOUT=10
READ_MAX_CHARS=20000
CODER_WORKSPACE_DIR=workspace_coder

# MCP client: seconds to wait for each answer of the MCP server
MCP_TIMEOUT=30

# QA agent: tests folder (relative to the repo root, never overlapping the
# Coder's), small model (C4.5), attempts to produce runnable tests (>= 1),
# per-test timeout in seconds (>= 1 and lower than EXEC_TIMEOUT; unset, it is
# 2 lowered to fit a lower EXEC_TIMEOUT, never below 1)
QA_WORKSPACE_DIR=workspace_qa
QA_MODEL=openai/gpt-4.1-mini
QA_MAX_ATTEMPTS=2
# QA_TEST_TIMEOUT=2

# Coder-QA loop: QA reviews per task (>= 1, C3.3), seconds a whole run may
# take (>= 1, checked between steps), Coder improvement passes per
# submission after its self-evaluation (>= 1)
QA_MAX_ITERATIONS=5
RUN_TIMEOUT=1800
REFLECTION_MAX_ROUNDS=1
