# Copy to .env and fill in real values. Never commit .env.

# LLM (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openai/gpt-4.1-mini

# Logging: DEBUG shows the full LLM input, INFO the retrieved memories
LOG_LEVEL=INFO

# Memory
SLIDING_WINDOW_SIZE=5
MEMORY_TOP_K=3
CHROMA_PATH=.chroma
# Set only when running against a Chroma server (Docker)
# CHROMA_HOST=chroma
# CHROMA_PORT=8000
