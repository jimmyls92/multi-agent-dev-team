# Copy to .env and fill in real values. Never commit .env.

# LLM (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Coder: small, fast model. PM: larger model, 2-4 calls per run (C4.5)
LLM_MODEL=openai/gpt-4.1-mini
PM_MODEL=openai/gpt-4.1

# Logging: DEBUG shows the full LLM input, INFO the retrieved memories
LOG_LEVEL=INFO

# Memory
SLIDING_WINDOW_SIZE=5
MEMORY_TOP_K=3
CHROMA_PATH=.chroma
# Set only when running against a Chroma server (Docker)
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# Tools: script timeout in seconds (1-30), read_file limit in characters,
# agent working directory (relative to the repo root)
EXEC_TIMEOUT=10
READ_MAX_CHARS=20000
WORKSPACE_DIR=workspace
